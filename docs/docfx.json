{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      },
      {
        "src": "..",
        "files": [
          "README.md",
          "samples/README.md",
          "src/*/README.md"
        ],
        "dest": "articles"
      }
    ],
    "resource": [
      {
        "src": "..",
        "files": [
          "logo/logo.png"
        ],
        "dest": "articles"
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "AndreyAkaSkif.ServiceDefaults",
      "_appTitle": "AndreyAkaSkif.ServiceDefaults",
      "_enableSearch": true,
      "pdf": false
    }
  }
}
