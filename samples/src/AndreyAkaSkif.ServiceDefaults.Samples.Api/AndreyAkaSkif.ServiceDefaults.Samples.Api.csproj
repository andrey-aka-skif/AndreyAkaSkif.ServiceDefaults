<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Title>Service Defaults Sample Api</Title>
    <Description>Демонстрационный Web-API, использующий пакеты AndreyAkaSkif.ServiceDefaults</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Спецификация собирается в файл при каждой сборке и коммитится в репозиторий:
         так изменение контракта видно в диффе, а расхождение ловит CI.
         Каталог задаётся относительно файла проекта -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <!-- Пакет нужен только сборке: генерацию файла спецификации выполняет его MSBuild-цель -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\AndreyAkaSkif.ServiceDefaults\AndreyAkaSkif.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\src\AndreyAkaSkif.ServiceDefaults.OpenApi\AndreyAkaSkif.ServiceDefaults.OpenApi.csproj" />
    <ProjectReference Include="..\..\..\src\AndreyAkaSkif.ServiceDefaults.Serilog\AndreyAkaSkif.ServiceDefaults.Serilog.csproj" />
    <ProjectReference Include="..\..\..\src\AndreyAkaSkif.ServiceDefaults.Swagger\AndreyAkaSkif.ServiceDefaults.Swagger.csproj" />

    <!-- Раскомментировать вместе с содержимым AppConfiguration\AppDbContextsConfigureExtensions.cs -->
    <!-- <ProjectReference Include="..\..\..\src\AndreyAkaSkif.ServiceDefaults.PostgreSQL\AndreyAkaSkif.ServiceDefaults.PostgreSQL.csproj" /> -->
  </ItemGroup>

</Project>
