<Project>
  <!-- MSBuild останавливается на ближайшем Directory.Build.props, поэтому корневой
       нужно импортировать явно — иначе тесты не получат ни TargetFramework, ни анализаторы -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Настройки документирования -->
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Тестовые проекты не пакуются -->
    <IsPackable>False</IsPackable>
  </PropertyGroup>

  <!-- CA1707 для тестов отключён в корневом .editorconfig, секция [tests/**/*.cs] -->
</Project>
